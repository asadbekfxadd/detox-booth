generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COURIER
  OWNER
  ADMIN
  MANAGER
  CASHIER
  BARISTA
  WAREHOUSE
  ACCOUNTANT
  WAITER
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum OrderSource {
  WEB
  POS
  /// Гость заказал сам по QR-коду на столе
  TABLE
}
enum BillStatus {
  OPEN
  PAID
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum Unit {
  G
  KG
  ML
  L
  PC
}

enum TxType {
  PURCHASE
  SALE
  WRITE_OFF
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  COUNT
  /// Акт приготовления: сырьё ушло в заготовку
  PRODUCTION_OUT
  /// Акт приготовления: заготовка появилась на складе
  PRODUCTION_IN
}

enum WriteOffReason {
  EXPIRED
  SPOILED
  DAMAGED
  PRODUCTION_WASTE
  EMPLOYEE_ERROR
  OTHER
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum LoyaltyTxType {
  EARN
  SPEND
  BONUS
  REFERRAL
  ADJUST
}

enum DiscountType {
  PERCENT
  FIXED
}

enum NotificationType {
  LOW_STOCK
  EXPIRATION
  ORDER_DELAY
  LARGE_WRITE_OFF
  INVENTORY_VARIANCE
  PAYMENT_ERROR
}

enum ExpenseCategory {
  RENT
  SALARY
  UTILITIES
  MARKETING
  DELIVERY
  OTHER
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  IN
  OUT
}

model Location {
  id String @id @default(cuid())
  name String
  address String?
  phone String?
  tables DiningTable[]
  deliveryZones DeliveryZone[]
  reservations Reservation[]
  lat Float?
  lng Float?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  users User[]
  orders Order[]
  stocks StockItem[]
  batches Batch[]
  productionActs ProductionAct[]
  shifts Shift[]
  purchases PurchaseOrder[]
  writeOffs WriteOff[]
  expenses Expense[]
  notifications Notification[]
}

model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  role Role
  locationId String?
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  isActive Boolean @default(true)
  /// Оклад в месяц, UZS. Входит в фонд оплаты труда для калькуляции. Пусто — сотрудник не учитывается в себестоимости
  monthlySalary Decimal? @db.Decimal(14,2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shifts Shift[]
  writeOffs WriteOff[]
  audit AuditLog[]
  orders Order[] @relation("OrderCashier")
  waiterOrders Order[] @relation("OrderWaiter")
  courierOrders Order[] @relation("OrderCourier")
  @@index([role])
}

model Customer {
  id String @id @default(cuid())
  reservations Reservation[]
  name String
  phone String @unique
  email String?
  birthday DateTime?
  referredById String?
  createdAt DateTime @default(now())
  orders Order[]
  loyalty LoyaltyAccount?
}

model LoyaltyAccount {
  id String @id @default(cuid())
  customerId String @unique
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  points Int @default(0)
  txs LoyaltyTransaction[]
}
model LoyaltyTransaction {
  id String @id @default(cuid())
  accountId String
  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type LoyaltyTxType
  points Int
  orderId String?
  note String?
  createdAt DateTime @default(now())
  @@index([accountId, createdAt])
}

model PromoCode {
  id String @id @default(cuid())
  code String @unique
  type DiscountType
  value Decimal @db.Decimal(12,2)
  minOrder Decimal @default(0) @db.Decimal(12,2)
  usageLimit Int?
  usedCount Int @default(0)
  expiresAt DateTime?
  isActive Boolean @default(true)
}

enum PromotionKind {
  /// Купи N — следующие M со скидкой (2+1, второй за полцены)
  BUY_GET
  /// Набор из позиций за фиксированную цену
  COMBO
  /// Скидка от суммы заказа (ступени)
  THRESHOLD
  /// Скидка на первый заказ клиента
  FIRST_ORDER
}

/// Акция, которая применяется к корзине сама, без промокода. Условия лежат в config (формат зависит от kind).
model Promotion {
  id String @id @default(cuid())
  name String
  description String?
  kind PromotionKind
  config Json
  isActive Boolean @default(true)
  onSite Boolean @default(true)
  onPos Boolean @default(true)
  /// Можно ли вводить промокод вместе с этой акцией
  allowCode Boolean @default(false)
  /// Действует ли на позиции, которые уже подешевели по счастливым часам
  withHappyHour Boolean @default(false)
  /// Дни недели 1–7; пусто — каждый день
  days Int[]
  startMin Int @default(0)
  endMin Int @default(1440)
  startsAt DateTime?
  endsAt DateTime?
  totalLimit Int?
  perCustomerLimit Int?
  usedCount Int @default(0)
  discountTotal Decimal @default(0) @db.Decimal(14,2)
  sort Int @default(0)
  createdAt DateTime @default(now())
  uses PromotionUse[]
}

/// Применение акции к заказу: статистика и лимит на клиента.
model PromotionUse {
  id String @id @default(cuid())
  promotionId String
  promotion Promotion @relation(fields: [promotionId], references: [id])
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String?
  amount Decimal @db.Decimal(14,2)
  createdAt DateTime @default(now())
  @@index([promotionId, customerId])
  @@index([orderId])
}

/// Транзакция Payme (Merchant API): Payme присылает свой id, время и состояние; суммы в тийинах (1/100 сума).
/// Состояния: 1 — создана, 2 — оплачена, -1 — отменена до оплаты, -2 — возврат после оплаты.
model PaymeTransaction {
  id String @id
  orderId String
  paymentId String?
  amount BigInt
  state Int
  reason Int?
  time BigInt
  createTime BigInt
  performTime BigInt?
  cancelTime BigInt?
  @@index([orderId])
  @@index([createTime])
}

/// Транзакция Click (Shop API): prepare создаёт запись, complete подтверждает оплату.
model ClickTransaction {
  id Int @id @default(autoincrement())
  clickTransId String @unique
  orderId String
  amount Decimal @db.Decimal(14,2)
  /// PREPARED, COMPLETED, CANCELLED
  status String
  createdAt DateTime @default(now())
  @@index([orderId])
}

/// Счастливые часы: скидка на цену позиций по дням недели и времени (Ташкент). Действует на всех точках сети.
model HappyHour {
  id String @id @default(cuid())
  name String
  /// Скидка на цену позиции, %
  percent Int
  /// Дни недели: 1 — понедельник … 7 — воскресенье
  days Int[]
  /// Начало и конец в минутах от полуночи (конец не включается); через полночь — двумя правилами
  startMin Int
  endMin Int
  /// Только эта категория; пусто — всё меню
  categoryId String?
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
}

/// Зона доставки точки: цена, минимальный заказ, порог бесплатной доставки.
model DeliveryZone {
  id String @id @default(cuid())
  locationId String
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  name String
  fee Decimal @default(0) @db.Decimal(14,2)
  minOrder Decimal @default(0) @db.Decimal(14,2)
  /// С этой суммы заказа доставка бесплатна; пусто — всегда платная
  freeFrom Decimal? @db.Decimal(14,2)
  isActive Boolean @default(true)
  sort Int @default(0)
  orders Order[]
  @@index([locationId, isActive])
}

/// Станция кухни: бар, горячий цех, холодный цех. Категория относится к одной станции.
model Station {
  id String @id @default(cuid())
  name String @unique
  sort Int @default(0)
  categories Category[]
}

model Category {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  sort Int @default(0)
  stationId String?
  station Station? @relation(fields: [stationId], references: [id], onDelete: SetNull)
  products Product[]
  happyHours HappyHour[]
  equipment Equipment[]
  @@index([stationId])
}

/// Оборудование для калькуляции: выжималки, блендеры, холодильники. Амортизация = цена ÷ ресурс в напитках.
model Equipment {
  id String @id @default(cuid())
  name String
  price Decimal @db.Decimal(14,2)
  /// Сколько напитков оборудование отработает за срок службы
  lifeDrinks Int
  /// Пусто — работает на все напитки, иначе только на напитки этой категории
  categoryId String?
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  @@index([categoryId])
}

model Product {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String?
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  price Decimal @db.Decimal(12,2)
  image String?
  /// Видео «Как готовим»: ссылка на YouTube, файл .mp4/.webm или любую страницу с видео
  videoUrl String?
  calories Int?
  protein Decimal? @db.Decimal(6,1)
  carbs Decimal? @db.Decimal(6,1)
  fat Decimal? @db.Decimal(6,1)
  volumeMl Int?
  prepMinutes Int @default(3)
  allergens String[]
  isVegan Boolean @default(false)
  isHighProtein Boolean @default(false)
  isSugarFree Boolean @default(false)
  isAvailable Boolean @default(true)
  isArchived Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  recipe Recipe?
  modifiers Modifier[]
  orderItems OrderItem[]
  @@index([categoryId, isArchived])
}

model Modifier {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name String
  multiple Boolean @default(false)
  required Boolean @default(false)
  options ModifierOption[]
}
model ModifierOption {
  id String @id @default(cuid())
  modifierId String
  modifier Modifier @relation(fields: [modifierId], references: [id], onDelete: Cascade)
  name String
  priceDelta Decimal @default(0) @db.Decimal(12,2)
  recipeMultiplier Decimal @default(1) @db.Decimal(5,2)
  extraIngredientId String?
  extraQty Decimal? @db.Decimal(12,3)
  sizeItems RecipeSizeItem[]
}

model Ingredient {
  id String @id @default(cuid())
  sku String @unique
  name String
  category String
  unit Unit
  minStock Decimal @db.Decimal(12,3)
  maxStock Decimal @db.Decimal(12,3)
  avgCost Decimal @db.Decimal(12,2)
  shelfLifeDays Int?
  /// «Свой микс»: доплата к цене стакана, если гость выбрал этот ингредиент (UZS)
  mixSurcharge Decimal @default(0) @db.Decimal(12,2)
  /// «Свой микс»: сколько граммов весит одна штука (нужно только для ингредиентов в штуках)
  pieceWeightG Decimal? @db.Decimal(8,2)
  /// Выход годного после обработки, %: из 1000 г апельсина получается 450 мл сока = 45. В рецепте пишут то, что попало в стакан (нетто), со склада списывается больше (брутто)
  yieldPct Decimal @default(100) @db.Decimal(5,2)
  supplierId String?
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  recipeItems RecipeItem[]
  recipeSizeItems RecipeSizeItem[]
  /// Если это заготовка (полуфабрикат): из чего она делается
  prepRecipe PrepRecipe?
  prepItems PrepRecipeItem[]
  productionActs ProductionAct[]
  productionItems ProductionActItem[]
  stocks StockItem[]
  batches Batch[]
  purchaseItems PurchaseItem[]
  writeOffs WriteOff[]
  txs InventoryTransaction[]
}

model Recipe {
  id String @id @default(cuid())
  productId String @unique
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  items RecipeItem[]
  /// Своя граммовка для каждого размера (опции «Объём»). Если у размера есть строки здесь, берутся они, а не items × коэффициент
  sizeItems RecipeSizeItem[]
  updatedAt DateTime @updatedAt
}
model RecipeItem {
  id String @id @default(cuid())
  recipeId String
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  quantity Decimal @db.Decimal(12,3)
  @@unique([recipeId, ingredientId])
}

/// Граммовка ингредиента на порцию для конкретного размера (опции модификатора «Объём»)
model RecipeSizeItem {
  id String @id @default(cuid())
  recipeId String
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  optionId String
  option ModifierOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  quantity Decimal @db.Decimal(12,3)
  @@unique([optionId, ingredientId])
  @@index([recipeId])
}

/// Рецепт заготовки (полуфабриката): из этих ингредиентов получается outputQty заготовки.
/// Количества сырья — сколько брать со склада (брутто), потери уже заложены в outputQty.
model PrepRecipe {
  id String @id @default(cuid())
  ingredientId String @unique
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  /// Сколько заготовки получается (в г, мл или шт склада)
  outputQty Decimal @db.Decimal(12,3)
  items PrepRecipeItem[]
  updatedAt DateTime @updatedAt
}
model PrepRecipeItem {
  id String @id @default(cuid())
  prepId String
  prep PrepRecipe @relation(fields: [prepId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  quantity Decimal @db.Decimal(12,3)
  @@unique([prepId, ingredientId])
}

/// Акт приготовления: сырьё списано, заготовка оприходована по фактической себестоимости
model ProductionAct {
  id String @id @default(cuid())
  number Int @default(autoincrement())
  locationId String
  location Location @relation(fields: [locationId], references: [id])
  ingredientId String
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  /// Сколько собирались получить (по нему списано сырьё)
  plannedQty Decimal @db.Decimal(12,3)
  /// Сколько получилось на самом деле (оприходовано)
  outputQty Decimal @db.Decimal(12,3)
  totalCost Decimal @db.Decimal(14,2)
  note String?
  userId String?
  createdAt DateTime @default(now())
  items ProductionActItem[]
  @@index([locationId, createdAt])
  @@index([ingredientId])
}
model ProductionActItem {
  id String @id @default(cuid())
  actId String
  act ProductionAct @relation(fields: [actId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  quantity Decimal @db.Decimal(12,3)
  cost Decimal @db.Decimal(14,2)
  @@index([actId])
}

model StockItem {
  id String @id @default(cuid())
  locationId String
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity Decimal @default(0) @db.Decimal(12,3)
  @@unique([locationId, ingredientId])
}
model Batch {
  id String @id @default(cuid())
  locationId String
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  code String
  quantity Decimal @db.Decimal(12,3)
  unitCost Decimal @db.Decimal(12,2)
  receivedAt DateTime @default(now())
  expiresAt DateTime?
  @@index([locationId, ingredientId, expiresAt])
}
model InventoryTransaction {
  id String @id @default(cuid())
  locationId String
  ingredientId String
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  type TxType
  quantity Decimal @db.Decimal(12,3)
  unitCost Decimal @db.Decimal(12,2)
  batchId String?
  refType String?
  refId String?
  userId String?
  createdAt DateTime @default(now())
  @@index([locationId, ingredientId, createdAt])
  @@index([refType, refId])
}

model Supplier {
  id String @id @default(cuid())
  name String
  phone String?
  ingredients Ingredient[]
  purchases PurchaseOrder[]
}
model PurchaseOrder {
  id String @id @default(cuid())
  locationId String
  location Location @relation(fields: [locationId], references: [id])
  supplierId String
  supplier Supplier @relation(fields: [supplierId], references: [id])
  status PurchaseStatus @default(DRAFT)
  total Decimal @default(0) @db.Decimal(14,2)
  createdAt DateTime @default(now())
  receivedAt DateTime?
  items PurchaseItem[]
}
model PurchaseItem {
  id String @id @default(cuid())
  purchaseId String
  purchase PurchaseOrder @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  quantity Decimal @db.Decimal(12,3)
  unitCost Decimal @db.Decimal(12,2)
  expiresAt DateTime?
}

model WriteOff {
  id String @id @default(cuid())
  locationId String
  location Location @relation(fields: [locationId], references: [id])
  ingredientId String
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  quantity Decimal @db.Decimal(12,3)
  reason WriteOffReason
  cost Decimal @db.Decimal(12,2)
  userId String
  user User @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  @@index([locationId, createdAt])
}

model Shift {
  id String @id @default(cuid())
  locationId String
  location Location @relation(fields: [locationId], references: [id])
  userId String
  user User @relation(fields: [userId], references: [id])
  status ShiftStatus @default(OPEN)
  openingCash Decimal @default(0) @db.Decimal(12,2)
  closingCash Decimal? @db.Decimal(12,2)
  openedAt DateTime @default(now())
  closedAt DateTime?
  orders Order[]
  cashMovements CashMovement[]
}

/// Внесение и изъятие наличных в смене (размен, инкассация, оплата поставщику из кассы). Входит в «ожидается в кассе»
model CashMovement {
  id String @id @default(cuid())
  shiftId String
  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  userId String
  type CashMovementType
  amount Decimal @db.Decimal(12,2)
  reason String
  createdAt DateTime @default(now())
  @@index([shiftId])
}

/// Пользователь Telegram, открывший бота или Mini App. Номер телефона подтверждён самим Telegram (кнопка «Поделиться номером»)
model TelegramUser {
  /// id пользователя в Telegram (он же id личного чата с ботом)
  id String @id
  firstName String
  lastName String?
  username String?
  languageCode String?
  phone String?
  /// Пользователь заблокировал бота: уведомления ему не отправляем
  blocked Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Отменённая позиция заказа стола. Сама позиция удаляется из заказа, здесь остаётся след: что, сколько, почему, кто и кто подтвердил
model VoidedItem {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  locationId String
  productId String?
  name String
  quantity Int
  unitPrice Decimal @db.Decimal(12,2)
  reason String
  userId String
  /// Менеджер, подтвердивший отмену (может совпадать с userId, если у сотрудника есть право отмены)
  approvedById String?
  /// Позиция уже ушла на кухню: продукты по ней списаны и не возвращаются
  afterKitchen Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([locationId, createdAt])
  @@index([orderId])
}

model Order {
  id String @id @default(cuid())
  number Int @default(autoincrement())
  locationId String
  location Location @relation(fields: [locationId], references: [id])
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cashierId String?
  cashier User? @relation("OrderCashier", fields: [cashierId], references: [id], onDelete: SetNull)
  shiftId String?
  shift Shift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  source OrderSource
  fulfillment FulfillmentType @default(PICKUP)
  status OrderStatus @default(NEW)
  subtotal Decimal @db.Decimal(14,2)
  discount Decimal @default(0) @db.Decimal(14,2)
  deliveryFee Decimal @default(0) @db.Decimal(14,2)
  /// Сервисный сбор за столом (уже включён в total)
  serviceFee Decimal @default(0) @db.Decimal(14,2)
  total Decimal @db.Decimal(14,2)
  cogs Decimal @default(0) @db.Decimal(14,2)
  promoCode String?
  pointsEarned Int @default(0)
  pointsSpent Int @default(0)
  inventoryDeducted Boolean @default(false)
  address String?
  /// Желаемое время получения; null — «как можно скорее»
  scheduledFor DateTime?
  /// Комментарий клиента к заказу
  note String?
  /// Официант, принявший заказ у стола
  waiterId String?
  waiter User? @relation("OrderWaiter", fields: [waiterId], references: [id], onDelete: SetNull)
  /// Очередь подачи: 1 — сразу, 2 — горячее, 3 — десерт
  course Int @default(1)
  /// Заказ принят, но ещё не отправлен на кухню (ждёт команды официанта)
  onHold Boolean @default(false)
  /// Зона доставки, по которой посчитана цена
  deliveryZoneId String?
  deliveryZone DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  /// Курьер, назначенный на доставку
  courierId String?
  courier User? @relation("OrderCourier", fields: [courierId], references: [id], onDelete: SetNull)
  courierAssignedAt DateTime?
  /// Курьер забрал заказ и выехал (заказ остаётся READY до отметки «Доставлено»)
  pickedUpAt DateTime?
  /// Стол и счёт стола (заказы по QR). Заказы одного гостя за визит копятся в одном счёте.
  tableId String?
  table DiningTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  billId String?
  bill TableBill? @relation(fields: [billId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  completedAt DateTime?
  /// Заказ оформлен из Telegram Mini App: сюда бот пишет о статусе заказа
  telegramId String?
  items OrderItem[]
  payments Payment[]
  voidedItems VoidedItem[]
  @@index([telegramId])
  @@index([billId])
  @@index([tableId, status])
  @@index([locationId, createdAt])
  @@index([status])
  @@index([customerId, createdAt])
  @@index([shiftId])
  @@index([waiterId])
  @@index([courierId, status])
  promotionUses PromotionUse[]
}
model OrderItem {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id])
  quantity Int
  unitPrice Decimal @db.Decimal(12,2)
  modifiers Json @default("[]")
  /// Станция отметила позицию готовой (заказ становится READY, когда готовы все позиции)
  readyAt DateTime?
  @@index([orderId])
  @@index([productId])
}
model Payment {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method PaymentMethod
  status PaymentStatus @default(PENDING)
  amount Decimal @db.Decimal(14,2)
  /// Чаевые, принятые вместе с оплатой (в amount не входят)
  tip Decimal @default(0) @db.Decimal(14,2)
  /// Платёжный провайдер для онлайн-оплаты (null — оплата при получении)
  provider String?
  /// Идентификатор транзакции у провайдера: защита от повторной обработки вебхука
  externalId String?
  createdAt DateTime @default(now())
  @@index([orderId])
  @@unique([provider, externalId])
}

model Expense {
  id String @id @default(cuid())
  locationId String?
  location Location? @relation(fields: [locationId], references: [id])
  category ExpenseCategory
  amount Decimal @db.Decimal(14,2)
  note String?
  date DateTime @default(now())
  @@index([date])
}

model Notification {
  id String @id @default(cuid())
  locationId String?
  location Location? @relation(fields: [locationId], references: [id])
  type NotificationType
  message String
  isRead Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([isRead, createdAt])
}
model AuditLog {
  id String @id @default(cuid())
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action String
  entity String
  entityId String?
  oldValue Json?
  newValue Json?
  ip String?
  createdAt DateTime @default(now())
  @@index([entity, entityId])
  @@index([createdAt])
}
model Setting {
  key String @id
  value Json
}

/// Столик в зале. По токену из QR-кода гость попадает в меню с уже привязанным столом.
model DiningTable {
  id String @id @default(cuid())
  locationId String
  location Location @relation(fields: [locationId], references: [id])
  number Int
  /// Сколько гостей помещается: для подбора стола при брони
  seats Int @default(4)
  /// Неугадываемый токен в ссылке QR. Перевыпуск делает старый QR нерабочим.
  token String @unique
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  orders Order[]
  bills TableBill[]
  reservations Reservation[]
  @@unique([locationId, number])
}

/// Бронь стола. Стол подбирается автоматически по числу гостей и свободному времени.
model Reservation {
  id String @id @default(cuid())
  locationId String
  location Location @relation(fields: [locationId], references: [id])
  tableId String?
  table DiningTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name String
  phone String
  guests Int
  startsAt DateTime
  durationMin Int @default(90)
  status ReservationStatus @default(PENDING)
  note String?
  /// Депозит за бронь, UZS; принимает персонал, на сайте онлайн не оплачивается
  deposit Decimal @default(0) @db.Decimal(14,2)
  depositPaid Boolean @default(false)
  /// WEB — с сайта, STAFF — внесена сотрудником
  source String @default("WEB")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([locationId, startsAt])
  @@index([tableId, startsAt])
  @@index([phone])
}

/// Счёт стола. Один открытый счёт на стол (частичный уникальный индекс в миграции).
model TableBill {
  id String @id @default(cuid())
  number Int @default(autoincrement())
  tableId String
  table DiningTable @relation(fields: [tableId], references: [id])
  locationId String
  status BillStatus @default(OPEN)
  openedAt DateTime @default(now())
  /// Гость нажал «Попросить счёт»
  billRequestedAt DateTime?
  closedAt DateTime?
  closedById String?
  shiftId String?
  method PaymentMethod?
  /// Итог на момент закрытия (без отменённых заказов)
  total Decimal? @db.Decimal(14,2)
  orders Order[]
  @@index([tableId, status])
  @@index([locationId, status])
}
