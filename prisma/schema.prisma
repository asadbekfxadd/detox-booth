generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  CASHIER
  BARISTA
  WAREHOUSE
  ACCOUNTANT
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum OrderSource {
  WEB
  POS
  /// Гость заказал сам по QR-коду на столе
  TABLE
}
enum BillStatus {
  OPEN
  PAID
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum Unit {
  G
  KG
  ML
  L
  PC
}

enum TxType {
  PURCHASE
  SALE
  WRITE_OFF
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  COUNT
}

enum WriteOffReason {
  EXPIRED
  SPOILED
  DAMAGED
  PRODUCTION_WASTE
  EMPLOYEE_ERROR
  OTHER
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum LoyaltyTxType {
  EARN
  SPEND
  BONUS
  REFERRAL
  ADJUST
}

enum DiscountType {
  PERCENT
  FIXED
}

enum NotificationType {
  LOW_STOCK
  EXPIRATION
  ORDER_DELAY
  LARGE_WRITE_OFF
  INVENTORY_VARIANCE
  PAYMENT_ERROR
}

enum ExpenseCategory {
  RENT
  SALARY
  UTILITIES
  MARKETING
  DELIVERY
  OTHER
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model Location {
  id String @id @default(cuid())
  name String
  address String?
  phone String?
  tables DiningTable[]
  lat Float?
  lng Float?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  users User[]
  orders Order[]
  stocks StockItem[]
  batches Batch[]
  shifts Shift[]
  purchases PurchaseOrder[]
  writeOffs WriteOff[]
  expenses Expense[]
  notifications Notification[]
}

model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  role Role
  locationId String?
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shifts Shift[]
  writeOffs WriteOff[]
  audit AuditLog[]
  orders Order[]
  @@index([role])
}

model Customer {
  id String @id @default(cuid())
  name String
  phone String @unique
  email String?
  birthday DateTime?
  referredById String?
  createdAt DateTime @default(now())
  orders Order[]
  loyalty LoyaltyAccount?
}

model LoyaltyAccount {
  id String @id @default(cuid())
  customerId String @unique
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  points Int @default(0)
  txs LoyaltyTransaction[]
}
model LoyaltyTransaction {
  id String @id @default(cuid())
  accountId String
  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  type LoyaltyTxType
  points Int
  orderId String?
  note String?
  createdAt DateTime @default(now())
  @@index([accountId, createdAt])
}

model PromoCode {
  id String @id @default(cuid())
  code String @unique
  type DiscountType
  value Decimal @db.Decimal(12,2)
  minOrder Decimal @default(0) @db.Decimal(12,2)
  usageLimit Int?
  usedCount Int @default(0)
  expiresAt DateTime?
  isActive Boolean @default(true)
}

model Category {
  id String @id @default(cuid())
  name String @unique
  slug String @unique
  sort Int @default(0)
  products Product[]
}

model Product {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String?
  categoryId String
  category Category @relation(fields: [categoryId], references: [id])
  price Decimal @db.Decimal(12,2)
  image String?
  calories Int?
  protein Decimal? @db.Decimal(6,1)
  carbs Decimal? @db.Decimal(6,1)
  fat Decimal? @db.Decimal(6,1)
  volumeMl Int?
  prepMinutes Int @default(3)
  allergens String[]
  isVegan Boolean @default(false)
  isHighProtein Boolean @default(false)
  isSugarFree Boolean @default(false)
  isAvailable Boolean @default(true)
  isArchived Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  recipe Recipe?
  modifiers Modifier[]
  orderItems OrderItem[]
  @@index([categoryId, isArchived])
}

model Modifier {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name String
  multiple Boolean @default(false)
  required Boolean @default(false)
  options ModifierOption[]
}
model ModifierOption {
  id String @id @default(cuid())
  modifierId String
  modifier Modifier @relation(fields: [modifierId], references: [id], onDelete: Cascade)
  name String
  priceDelta Decimal @default(0) @db.Decimal(12,2)
  recipeMultiplier Decimal @default(1) @db.Decimal(5,2)
  extraIngredientId String?
  extraQty Decimal? @db.Decimal(12,3)
}

model Ingredient {
  id String @id @default(cuid())
  sku String @unique
  name String
  category String
  unit Unit
  minStock Decimal @db.Decimal(12,3)
  maxStock Decimal @db.Decimal(12,3)
  avgCost Decimal @db.Decimal(12,2)
  shelfLifeDays Int?
  supplierId String?
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  recipeItems RecipeItem[]
  stocks StockItem[]
  batches Batch[]
  purchaseItems PurchaseItem[]
  writeOffs WriteOff[]
  txs InventoryTransaction[]
}

model Recipe {
  id String @id @default(cuid())
  productId String @unique
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  items RecipeItem[]
  updatedAt DateTime @updatedAt
}
model RecipeItem {
  id String @id @default(cuid())
  recipeId String
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  quantity Decimal @db.Decimal(12,3)
  @@unique([recipeId, ingredientId])
}

model StockItem {
  id String @id @default(cuid())
  locationId String
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity Decimal @default(0) @db.Decimal(12,3)
  @@unique([locationId, ingredientId])
}
model Batch {
  id String @id @default(cuid())
  locationId String
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  code String
  quantity Decimal @db.Decimal(12,3)
  unitCost Decimal @db.Decimal(12,2)
  receivedAt DateTime @default(now())
  expiresAt DateTime?
  @@index([locationId, ingredientId, expiresAt])
}
model InventoryTransaction {
  id String @id @default(cuid())
  locationId String
  ingredientId String
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  type TxType
  quantity Decimal @db.Decimal(12,3)
  unitCost Decimal @db.Decimal(12,2)
  batchId String?
  refType String?
  refId String?
  userId String?
  createdAt DateTime @default(now())
  @@index([locationId, ingredientId, createdAt])
  @@index([refType, refId])
}

model Supplier {
  id String @id @default(cuid())
  name String
  phone String?
  ingredients Ingredient[]
  purchases PurchaseOrder[]
}
model PurchaseOrder {
  id String @id @default(cuid())
  locationId String
  location Location @relation(fields: [locationId], references: [id])
  supplierId String
  supplier Supplier @relation(fields: [supplierId], references: [id])
  status PurchaseStatus @default(DRAFT)
  total Decimal @default(0) @db.Decimal(14,2)
  createdAt DateTime @default(now())
  receivedAt DateTime?
  items PurchaseItem[]
}
model PurchaseItem {
  id String @id @default(cuid())
  purchaseId String
  purchase PurchaseOrder @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  quantity Decimal @db.Decimal(12,3)
  unitCost Decimal @db.Decimal(12,2)
  expiresAt DateTime?
}

model WriteOff {
  id String @id @default(cuid())
  locationId String
  location Location @relation(fields: [locationId], references: [id])
  ingredientId String
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])
  quantity Decimal @db.Decimal(12,3)
  reason WriteOffReason
  cost Decimal @db.Decimal(12,2)
  userId String
  user User @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  @@index([locationId, createdAt])
}

model Shift {
  id String @id @default(cuid())
  locationId String
  location Location @relation(fields: [locationId], references: [id])
  userId String
  user User @relation(fields: [userId], references: [id])
  status ShiftStatus @default(OPEN)
  openingCash Decimal @default(0) @db.Decimal(12,2)
  closingCash Decimal? @db.Decimal(12,2)
  openedAt DateTime @default(now())
  closedAt DateTime?
  orders Order[]
}

model Order {
  id String @id @default(cuid())
  number Int @default(autoincrement())
  locationId String
  location Location @relation(fields: [locationId], references: [id])
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cashierId String?
  cashier User? @relation(fields: [cashierId], references: [id], onDelete: SetNull)
  shiftId String?
  shift Shift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  source OrderSource
  fulfillment FulfillmentType @default(PICKUP)
  status OrderStatus @default(NEW)
  subtotal Decimal @db.Decimal(14,2)
  discount Decimal @default(0) @db.Decimal(14,2)
  deliveryFee Decimal @default(0) @db.Decimal(14,2)
  total Decimal @db.Decimal(14,2)
  cogs Decimal @default(0) @db.Decimal(14,2)
  promoCode String?
  pointsEarned Int @default(0)
  pointsSpent Int @default(0)
  inventoryDeducted Boolean @default(false)
  address String?
  /// Желаемое время получения; null — «как можно скорее»
  scheduledFor DateTime?
  /// Комментарий клиента к заказу
  note String?
  /// Стол и счёт стола (заказы по QR). Заказы одного гостя за визит копятся в одном счёте.
  tableId String?
  table DiningTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  billId String?
  bill TableBill? @relation(fields: [billId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  completedAt DateTime?
  items OrderItem[]
  payments Payment[]
  @@index([billId])
  @@index([tableId, status])
  @@index([locationId, createdAt])
  @@index([status])
  @@index([customerId, createdAt])
  @@index([shiftId])
}
model OrderItem {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id])
  quantity Int
  unitPrice Decimal @db.Decimal(12,2)
  modifiers Json @default("[]")
  @@index([orderId])
  @@index([productId])
}
model Payment {
  id String @id @default(cuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method PaymentMethod
  status PaymentStatus @default(PENDING)
  amount Decimal @db.Decimal(14,2)
  /// Платёжный провайдер для онлайн-оплаты (null — оплата при получении)
  provider String?
  /// Идентификатор транзакции у провайдера: защита от повторной обработки вебхука
  externalId String?
  createdAt DateTime @default(now())
  @@index([orderId])
  @@unique([provider, externalId])
}

model Expense {
  id String @id @default(cuid())
  locationId String?
  location Location? @relation(fields: [locationId], references: [id])
  category ExpenseCategory
  amount Decimal @db.Decimal(14,2)
  note String?
  date DateTime @default(now())
  @@index([date])
}

model Notification {
  id String @id @default(cuid())
  locationId String?
  location Location? @relation(fields: [locationId], references: [id])
  type NotificationType
  message String
  isRead Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([isRead, createdAt])
}
model AuditLog {
  id String @id @default(cuid())
  userId String?
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  action String
  entity String
  entityId String?
  oldValue Json?
  newValue Json?
  ip String?
  createdAt DateTime @default(now())
  @@index([entity, entityId])
  @@index([createdAt])
}
model Setting {
  key String @id
  value Json
}

/// Столик в зале. По токену из QR-кода гость попадает в меню с уже привязанным столом.
model DiningTable {
  id String @id @default(cuid())
  locationId String
  location Location @relation(fields: [locationId], references: [id])
  number Int
  /// Неугадываемый токен в ссылке QR. Перевыпуск делает старый QR нерабочим.
  token String @unique
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  orders Order[]
  bills TableBill[]
  @@unique([locationId, number])
}

/// Счёт стола. Один открытый счёт на стол (частичный уникальный индекс в миграции).
model TableBill {
  id String @id @default(cuid())
  number Int @default(autoincrement())
  tableId String
  table DiningTable @relation(fields: [tableId], references: [id])
  locationId String
  status BillStatus @default(OPEN)
  openedAt DateTime @default(now())
  /// Гость нажал «Попросить счёт»
  billRequestedAt DateTime?
  closedAt DateTime?
  closedById String?
  shiftId String?
  method PaymentMethod?
  /// Итог на момент закрытия (без отменённых заказов)
  total Decimal? @db.Decimal(14,2)
  orders Order[]
  @@index([tableId, status])
  @@index([locationId, status])
}
